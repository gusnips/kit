{
  "extends": ["./oxlint/base.json"],
  "plugins": [],
  "jsPlugins": [{ "name": "react-hooks-js", "specifier": "./oxlint/react-hooks.js" }],
  "ignorePatterns": ["**/dist/**", "**/node_modules/**"],
  "overrides": [
    {
      "files": ["react/**/*.{ts,tsx}"],
      "rules": {
        "react-hooks-js/purity": "error",
        "react-hooks-js/config": "error",
        "react-hooks-js/gating": "error"
      }
    }
  ]
}
