{
  "name": "kit-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "tokens",
    "oxlint",
    "http",
    "locale",
    "br",
    "cnpj",
    "react",
    "vite",
    "migrate",
    "sdkgen",
    "server"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck && tsc -p tsconfig.scripts.json",
    "lint": "oxlint tokens oxlint http locale br cnpj react vite migrate sdkgen server scripts",
    "purity": "bun run scripts/check-purity.ts && bun run --filter '@gusnips/server' purity",
    "exports": "bun run scripts/check-exports.ts",
    "release:check": "bun run scripts/check-release.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format:check && bun run build && bun run lint && bun run typecheck && bun run purity && bun run exports && bun run test"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.2"
  }
}
